# Copy to .env (git-ignored) — loaded by @youlearn/config for every app/package, and by docker compose.

NODE_ENV=development

# docker/compose.yml (postgres)
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=youlearn
POSTGRES_PORT=5432

DATABASE_URL=postgres://dev:dev@localhost:5432/youlearn

# API (fastify)
API_HOST=0.0.0.0
API_PORT=3001
API_URL=http://localhost:3001

# Web (next) — public origin, also used as Better Auth base URL
WEB_URL=http://localhost:3000

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# First admin, created if missing when the API starts (or via `pnpm --filter @youlearn/auth seed:admin`).
# Leave both empty to disable. If the email already exists the account is kept and promoted to admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Groups (comma separated) created on first install, when no group exists yet. Managed from the admin UI afterwards.
DEFAULT_GROUPS=Développeur,Commercial

# Email domains accepted when an admin creates a user (comma separated, without the "@").
# Empty = any domain. ADMIN_EMAIL must belong to one of them.
ALLOWED_EMAIL_DOMAINS=
