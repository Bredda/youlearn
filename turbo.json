{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:generate": {
			"cache": false,
			"persistent": false
		},
		"db:migrate": {
			"cache": false,
			"persistent": false
		},
		"db:push": {
			"cache": false,
			"persistent": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		}
	},
	"globalDependencies": [".env"],
	"globalPassThroughEnv": [
		"NODE_ENV",
		"DATABASE_URL",
		"API_HOST",
		"API_PORT",
		"API_URL",
		"WEB_URL",
		"BETTER_AUTH_SECRET",
		"ADMIN_EMAIL",
		"ADMIN_PASSWORD",
		"ADMIN_NAME",
		"DEFAULT_GROUPS",
		"ALLOWED_EMAIL_DOMAINS",
		"S3_ENDPOINT",
		"S3_BUCKET",
		"S3_DEPRECATED_BUCKET",
		"S3_ACCESS_KEY",
		"S3_SECRET_KEY",
		"S3_REGION"
	]
}
